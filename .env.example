H2V_DOMAIN=h2v.example.com
PUBLIC_SERVER_IP=
H2V_HOST=127.0.0.1
H2V_PORT=8000
H2V_PUBLIC_PORT=443
H2V_JWT_SECRET=
H2V_JWT_ACCESS_TTL=15m
H2V_JWT_REFRESH_TTL=720h
H2V_ROOT_DIR=/opt/h2v
H2V_FRONTEND_DIR=/opt/h2v/frontend
H2V_TEMPLATES_DIR=/opt/h2v/templates
H2V_DISABLE_SYSTEMCTL=false
H2V_ALLOW_INSECURE_DEFAULTS=false
H2V_ARGON2_MAX_PARALLEL=2

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=h2v
DB_USER=h2v
DB_PASSWORD=
DB_SSLMODE=disable

XRAY_BINARY=/usr/local/bin/xray
XRAY_API_ADDR=127.0.0.1:10085
XRAY_CONFIG_PATH=/opt/h2v/configs/xray/config.json
XRAY_GEODATA_DIR=/opt/h2v/data/geodata
XRAY_LOCATION_ASSET=/opt/h2v/data/geodata
XRAY_GEOIP_URL=https://github.com/v2fly/geoip/releases/latest/download/geoip.dat
XRAY_GEOSITE_URL=https://github.com/v2fly/domain-list-community/releases/latest/download/dlc.dat

VLESS_PORT=8444
VLESS_UDP_ENABLED=false
VLESS_XUDP_ENABLED=false
REALITY_DEST=www.google.com:443
REALITY_SNI=www.google.com
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
REALITY_SHORT_IDS=
REALITY_FINGERPRINT=chrome
XRAY_SNIFFING_ENABLED=true
XRAY_SNIFFING_DEST_OVERRIDE=http,tls

HY2_CONFIG_PATH=/opt/h2v/configs/hysteria/config.json
HY2_TRAFFIC_URL=http://127.0.0.1:7653
HY2_TRAFFIC_SECRET=

HY2_DOMAIN=h2v.example.com
HY2_PORT=8443
HY2_OBFS_ENABLED=true
HY2_OBFS_PASSWORD=
HY2_BANDWIDTH_UP=1 gbps
HY2_BANDWIDTH_DOWN=1 gbps
HY2_MASQUERADE_URL=https://www.google.com
HY2_CERT_PATH=/etc/letsencrypt/live/h2v.example.com/fullchain.pem
HY2_KEY_PATH=/etc/letsencrypt/live/h2v.example.com/privkey.pem

SUB_URL_PREFIX=https://h2v.example.com
SUB_UPDATE_INTERVAL_HOURS=24

BACKUP_DIR=/opt/h2v/data/backups
BACKUP_RETENTION_DAYS=14

TRAFFIC_RETENTION_DAYS=180

H2V_COLLECTOR_INTERVAL=10s
H2V_ENFORCER_INTERVAL=30s
H2V_CORE_RECONCILE_INTERVAL=60s
H2V_CACHE_REFRESH_INTERVAL=5m
